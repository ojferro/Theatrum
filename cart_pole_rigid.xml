<mujoco>
  <!-- This file specifies things in degrees. The code/simulator uses radians -->
  <compiler autolimits="true" angle="degree"/>

  <asset>
    <mesh file="Basis_m.stl"/>
    <mesh file="ODrive_m.stl"/>
    <mesh file="Nucleo_m.stl"/>
    <mesh file="Battery_m.stl"/>
  </asset>

  <visual>
    <headlight ambient="0.5 0.5 0.5" />
  </visual>

  <option timestep="0.001" integrator="RK4"/>

  <default>
    <geom rgba="1. 1. 1. 1."/>
    <default class="wheel">
      <geom type="cylinder" size=".03 .01"/>
    </default>
    <default class="decor">
      <site type="box"/>
    </default>
  </default>

  <worldbody>
    <body name="pendulum" pos="0 0 0" euler="0 0 0">

        <freejoint/>
        <!-- <joint name="pivot" axis="0 1 0" pos="0 0 0"/> -->

        <geom type="mesh" mesh="Basis_m" pos="0 0 0.283" size="0.01 0.01 0.01" euler="90 90 0" mass="0.810"/>
        <!-- <geom type="mesh" mesh="Battery_m" pos="0 0 0.40" size="0.01 0.01 0.01" euler="-90 90 0" mass="0.810"/> -->

        <!-- <geom name="bodygeom" type="box" pos="0.01 0 0.35" size=".05 .05 .05" mass="1.62"/> -->
        <!-- <geom name="battery" type="box" pos="0 0 0.40" size=".055 .03 .015" mass="0.8"/>
        <geom name="mybox" type="box" pos="0 0 0.2" size=".055 .03 .015" mass="0.8"/> -->

    </body>
  </worldbody>
</mujoco>